#include <input/processors.dtsi>

/ {
    /* Split input: receives touchpad data forwarded from peripheral (right) */
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        tps43_split: tps43_split@74 {
            compatible = "zmk,input-split";
            reg = <0x74>;
        };
    };

    tps43_listener: tps43_listener {
        compatible = "zmk,input-listener";
        device = <&tps43_split>;
        /* Pointer sensitivity: multiplies X/Y by 3/2. Tune the ratio to
         * taste — first knob to reach for if the cursor feels slow/fast. */
        input-processors = <&zip_xy_scaler 3 2>;
    };
};
